rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'adereraadenike@gmail.com' && request.auth.token.email_verified == true) ||
        request.auth.token.email == 'admin@summitvaultcapital.online' ||
        request.auth.token.email == 'admin@summitvault.com'
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 100)) &&
        (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 64)) &&
        (!('totalBalance' in data) || data.totalBalance is number) &&
        (!('investedAmount' in data) || data.investedAmount is number) &&
        (!('cashBalance' in data) || data.cashBalance is number) &&
        (!('returnsAmount' in data) || data.returnsAmount is number) &&
        (!('unreadNotificationsCount' in data) || data.unreadNotificationsCount is number) &&
        (!('totalNotificationsCount' in data) || data.totalNotificationsCount is number) &&
        (!('role' in data) || data.role in ['client', 'admin']) &&
        (!('status' in data) || data.status in ['active', 'suspended', 'pending']) &&
        (!('kycStatus' in data) || data.kycStatus in ['verified', 'pending', 'action_required']) &&
        (!('assignedAgentId' in data) || (data.assignedAgentId is string && data.assignedAgentId.size() <= 128)) &&
        (!('assignedAgentName' in data) || (data.assignedAgentName is string && data.assignedAgentName.size() <= 120)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'amount', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.type in ['deposit', 'withdrawal', 'buy', 'sell', 'dividend', 'fee'] &&
        data.amount is number &&
        (!('assetName' in data) || (data.assetName is string && data.assetName.size() <= 200)) &&
        data.status in ['completed', 'pending', 'failed'] &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64));
    }

    function isValidInsurancePolicy(data) {
      return data.keys().hasAll(['id', 'userId', 'policyNumber', 'type', 'coverage', 'premium', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.policyNumber is string && data.policyNumber.size() <= 64 &&
        data.type is string && data.type.size() <= 100 &&
        data.coverage is number &&
        data.premium is number &&
        data.status in ['active', 'pending', 'lapsed'] &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidPaymentCard(data) {
      return data.keys().hasAll(['id', 'userId', 'methodType', 'brand', 'holderName', 'last4']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.methodType in ['card', 'bank', 'crypto', 'paypal', 'other'] &&
        data.brand is string && data.brand.size() <= 120 &&
        data.holderName is string && data.holderName.size() <= 160 &&
        data.last4 is string && data.last4.size() <= 32 &&
        (!('expiry' in data) || (data.expiry is string && data.expiry.size() <= 120)) &&
        (!('details' in data) || (data.details is string && data.details.size() <= 300)) &&
        (!('isDefault' in data) || data.isDefault is bool) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'message', 'category', 'read', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.message is string && data.message.size() <= 3000 &&
        data.category in ['account_alert', 'invoice', 'security', 'funding', 'system'] &&
        data.read is bool &&
        (!('priority' in data) || data.priority in ['critical', 'high', 'normal']) &&
        (!('readAt' in data) || (data.readAt is string && data.readAt.size() <= 64)) &&
        (!('requiresChatOpen' in data) || data.requiresChatOpen is bool) &&
        (!('senderAgentName' in data) || (data.senderAgentName is string && data.senderAgentName.size() <= 120)) &&
        (!('referenceCode' in data) || (data.referenceCode is string && data.referenceCode.size() <= 64)) &&
        (!('invoiceAmount' in data) || data.invoiceAmount is number) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['userId']) &&
        data.userId is string && data.userId.size() <= 128 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256)) &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 200)) &&
        (!('selectedAgentId' in data) || (data.selectedAgentId is string && data.selectedAgentId.size() <= 128)) &&
        (!('selectedAgentName' in data) || (data.selectedAgentName is string && data.selectedAgentName.size() <= 120)) &&
        (!('selectedAgentRole' in data) || (data.selectedAgentRole is string && data.selectedAgentRole.size() <= 120)) &&
        (!('selectedAgentAvatar' in data) || (data.selectedAgentAvatar is string && data.selectedAgentAvatar.size() <= 500)) &&
        (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 2000)) &&
        (!('lastMessageAt' in data) || (data.lastMessageAt is string && data.lastMessageAt.size() <= 64)) &&
        (!('unreadByAdmin' in data) || data.unreadByAdmin is number) &&
        (!('unreadByClient' in data) || data.unreadByClient is number) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'senderRole', 'text', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.senderRole in ['client', 'admin'] &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 200)) &&
        (!('agentId' in data) || (data.agentId is string && data.agentId.size() <= 128)) &&
        (!('agentName' in data) || (data.agentName is string && data.agentName.size() <= 120)) &&
        (!('agentRole' in data) || (data.agentRole is string && data.agentRole.size() <= 120)) &&
        (!('agentAvatar' in data) || (data.agentAvatar is string && data.agentAvatar.size() <= 500)) &&
        (!('messageType' in data) || data.messageType in ['text', 'funding_request', 'invoice', 'account_alert', 'letter']) &&
        (!('fundingOrigin' in data) || (data.fundingOrigin is string && data.fundingOrigin.size() <= 200)) &&
        (!('fundingReason' in data) || (data.fundingReason is string && data.fundingReason.size() <= 300)) &&
        (!('fundingAmount' in data) || data.fundingAmount is number) &&
        (!('letterTitle' in data) || (data.letterTitle is string && data.letterTitle.size() <= 200)) &&
        (!('letterCategory' in data) || (data.letterCategory is string && data.letterCategory.size() <= 120)) &&
        (!('letterReference' in data) || (data.letterReference is string && data.letterReference.size() <= 64)) &&
        (!('invoiceAmount' in data) || data.invoiceAmount is number) &&
        (!('invoiceDueDate' in data) || (data.invoiceDueDate is string && data.invoiceDueDate.size() <= 64)) &&
        (!('requiresAction' in data) || data.requiresAction is bool) &&
        data.text is string && data.text.size() <= 4000 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUserProfile(request.resource.data);
      allow delete: if true;

      match /transactions/{transactionId} {
        allow read: if true;
        allow create, update: if isValidTransaction(request.resource.data);
        allow delete: if true;
      }

      match /policies/{policyId} {
        allow read: if true;
        allow create, update: if isValidInsurancePolicy(request.resource.data);
        allow delete: if true;
      }

      match /cards/{cardId} {
        allow read: if true;
        allow create, update: if isValidPaymentCard(request.resource.data);
        allow delete: if true;
      }

      match /notifications/{notificationId} {
        allow read: if true;
        allow create, update: if isValidNotification(request.resource.data);
        allow delete: if true;
      }
    }

    match /chats/{chatId} {
      allow read: if true;
      allow create, update: if isValidChatSession(request.resource.data);
      allow delete: if true;

      match /messages/{messageId} {
        allow read: if true;
        allow create, update: if isValidChatMessage(request.resource.data);
        allow delete: if true;
      }
    }

    match /letterTemplates/{templateId} {
      allow read, write: if true;
    }

    match /agents/{agentId} {
      allow read: if true;
      allow write: if true;
    }

    match /system/{docId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if isOwner(adminId) || isAdmin();
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
