{
  "entities": {
    "userProfile": {
      "title": "User Profile and Balances",
      "description": "User profile data, investment metrics, cash balances, notification counters, and assigned advisor",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique ID of the user",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "maxLength": 256
        },
        "firstName": {
          "type": "string",
          "description": "User first name",
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "description": "User last name",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "User phone number",
          "maxLength": 64
        },
        "totalBalance": {
          "type": "number",
          "description": "Total account balance in USD"
        },
        "investedAmount": {
          "type": "number",
          "description": "Total amount invested in assets"
        },
        "cashBalance": {
          "type": "number",
          "description": "Liquid uninvested cash balance"
        },
        "returnsAmount": {
          "type": "number",
          "description": "All-time accumulated returns"
        },
        "unreadNotificationsCount": {
          "type": "number",
          "description": "Real-time count of unread notifications"
        },
        "totalNotificationsCount": {
          "type": "number",
          "description": "Real-time total count of notifications"
        },
        "role": {
          "type": "string",
          "enum": ["client", "admin"],
          "description": "User role permissions"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended", "pending"],
          "description": "Account lifecycle status"
        },
        "kycStatus": {
          "type": "string",
          "enum": ["verified", "pending", "action_required"],
          "description": "KYC verification state"
        },
        "assignedAgentId": {
          "type": "string",
          "description": "ID of the assigned wealth advisor",
          "maxLength": 128
        },
        "assignedAgentName": {
          "type": "string",
          "description": "Name of the assigned wealth advisor",
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "description": "Internal fiduciary notes",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 64
        }
      },
      "required": ["userId", "email"]
    },
    "transaction": {
      "title": "Transaction Record",
      "description": "Record of deposits, withdrawals, and investments",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique transaction ID",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Auth UID of the owner",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "enum": ["deposit", "withdrawal", "buy", "sell", "dividend", "fee"],
          "description": "Type of financial transaction"
        },
        "amount": {
          "type": "number",
          "description": "Amount transferred or invested"
        },
        "assetName": {
          "type": "string",
          "description": "Name or symbol of the asset or source/destination",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["completed", "pending", "failed"],
          "description": "Execution status"
        },
        "timestamp": {
          "type": "string",
          "description": "Transaction timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "type", "amount", "status"]
    },
    "insurancePolicy": {
      "title": "Insurance Policy",
      "description": "Insurance policy held by the client",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique policy ID",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Auth UID of the policy holder",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "policyNumber": {
          "type": "string",
          "description": "Public policy tracking number",
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "description": "Policy line of business or type",
          "maxLength": 100
        },
        "coverage": {
          "type": "number",
          "description": "Coverage limit amount"
        },
        "premium": {
          "type": "number",
          "description": "Monthly or annual premium"
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending", "lapsed"],
          "description": "Current policy state"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "policyNumber", "type", "coverage", "premium", "status"]
    },
    "paymentCard": {
      "title": "Linked Withdrawal Method",
      "description": "Client withdrawal destination (bank card, bank wire/ACH, crypto wallet, PayPal, or other)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique withdrawal method ID",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "methodType": {
          "type": "string",
          "enum": ["card", "bank", "crypto", "paypal", "other"],
          "description": "Withdrawal destination type"
        },
        "brand": {
          "type": "string",
          "description": "Card brand, bank name, coin ticker (BTC/ETH/USDT), or PayPal",
          "maxLength": 120
        },
        "holderName": {
          "type": "string",
          "description": "Account holder, wallet label, or PayPal email",
          "maxLength": 160
        },
        "last4": {
          "type": "string",
          "description": "Last 4 digits or short identifier",
          "maxLength": 32
        },
        "expiry": {
          "type": "string",
          "description": "Expiry, network name, routing summary, or payout detail",
          "maxLength": 120
        },
        "details": {
          "type": "string",
          "description": "Full wallet address, PayPal email, or settlement instructions",
          "maxLength": 300
        },
        "isDefault": {
          "type": "boolean",
          "description": "Whether this is the default withdrawal method"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "methodType", "brand", "holderName", "last4"]
    },
    "userNotification": {
      "title": "User Notification",
      "description": "Real-time notification for a user managed by Admin and User",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Notification ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Recipient user ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Notification headline",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "description": "Notification body text",
          "maxLength": 3000
        },
        "category": {
          "type": "string",
          "enum": ["account_alert", "invoice", "security", "funding", "system"],
          "description": "Category of notification"
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "high", "normal"],
          "description": "Priority level"
        },
        "read": {
          "type": "boolean",
          "description": "Whether the user has read the notification"
        },
        "readAt": {
          "type": "string",
          "description": "ISO timestamp when read",
          "maxLength": 64
        },
        "requiresChatOpen": {
          "type": "boolean",
          "description": "Whether clicking this notification opens the personal advisor chat"
        },
        "senderAgentName": {
          "type": "string",
          "description": "Advisor or department that issued the alert",
          "maxLength": 120
        },
        "referenceCode": {
          "type": "string",
          "description": "Reference ID or Invoice number",
          "maxLength": 64
        },
        "invoiceAmount": {
          "type": "number",
          "description": "Optional invoice amount in USD"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "title", "message", "category", "read", "createdAt"]
    },
    "chatSession": {
      "title": "Client Chat Session",
      "description": "Real-time conversation metadata between a client and admin/agents",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Client user ID",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "description": "Client email",
          "maxLength": 256
        },
        "userName": {
          "type": "string",
          "description": "Client display name",
          "maxLength": 200
        },
        "selectedAgentId": {
          "type": "string",
          "description": "ID of the agent chosen by the client or admin",
          "maxLength": 128
        },
        "selectedAgentName": {
          "type": "string",
          "description": "Name of the selected agent",
          "maxLength": 120
        },
        "selectedAgentRole": {
          "type": "string",
          "description": "Role of the selected agent",
          "maxLength": 120
        },
        "selectedAgentAvatar": {
          "type": "string",
          "description": "Avatar URL of the selected agent",
          "maxLength": 500
        },
        "lastMessage": {
          "type": "string",
          "description": "Preview of the most recent message",
          "maxLength": 2000
        },
        "lastMessageAt": {
          "type": "string",
          "description": "ISO timestamp of last message",
          "maxLength": 64
        },
        "unreadByAdmin": {
          "type": "number",
          "description": "Count of messages unread by admin"
        },
        "unreadByClient": {
          "type": "number",
          "description": "Count of messages unread by client"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 64
        }
      },
      "required": ["userId"]
    },
    "chatMessage": {
      "title": "Chat Message",
      "description": "Individual message, funding request, invoice, or official letter inside a client chat thread",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Client UID who owns the thread",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "senderRole": {
          "type": "string",
          "enum": ["client", "admin"],
          "description": "Whether sent by client or admin/agent"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of sender",
          "maxLength": 200
        },
        "agentId": {
          "type": "string",
          "description": "Agent persona ID associated with the message",
          "maxLength": 128
        },
        "agentName": {
          "type": "string",
          "description": "Agent persona name",
          "maxLength": 120
        },
        "agentRole": {
          "type": "string",
          "description": "Agent persona title",
          "maxLength": 120
        },
        "agentAvatar": {
          "type": "string",
          "description": "Agent avatar URL",
          "maxLength": 500
        },
        "text": {
          "type": "string",
          "description": "Message content",
          "maxLength": 4000
        },
        "messageType": {
          "type": "string",
          "enum": ["text", "funding_request", "invoice", "account_alert", "letter"],
          "description": "Type of structured chat item"
        },
        "fundingOrigin": {
          "type": "string",
          "description": "Origin institution or method for a deposit request",
          "maxLength": 200
        },
        "fundingReason": {
          "type": "string",
          "description": "Stated reason for deposit",
          "maxLength": 300
        },
        "fundingAmount": {
          "type": "number",
          "description": "Requested deposit amount in USD"
        },
        "letterTitle": {
          "type": "string",
          "description": "Official title of the letter, invoice, or alert",
          "maxLength": 200
        },
        "letterCategory": {
          "type": "string",
          "description": "Subcategory of the letter or account alert",
          "maxLength": 120
        },
        "letterReference": {
          "type": "string",
          "description": "Invoice or official letter reference number",
          "maxLength": 64
        },
        "invoiceAmount": {
          "type": "number",
          "description": "Amount due on an official invoice"
        },
        "invoiceDueDate": {
          "type": "string",
          "description": "Due date for an official invoice",
          "maxLength": 64
        },
        "requiresAction": {
          "type": "boolean",
          "description": "Whether client acknowledgment or response is required"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "userId", "senderRole", "text", "createdAt"]
    },
    "letterTemplate": {
      "title": "Admin Letter & Alert Template",
      "description": "Reusable template for official letters, invoices, and account alerts",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Template ID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Template display name",
          "maxLength": 150
        },
        "templateType": {
          "type": "string",
          "enum": ["invoice", "account_alert", "letter"],
          "description": "Template classification"
        },
        "category": {
          "type": "string",
          "description": "Alert or invoice category label",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "description": "Subject/Header of the document",
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "description": "Template body text",
          "maxLength": 3500
        },
        "defaultAmount": {
          "type": "number",
          "description": "Optional default invoice amount"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["id", "name", "templateType", "title", "body"]
    },
    "agentRecord": {
      "title": "Accredited Agent",
      "description": "Wealth advisor and insurance specialist profile",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Agent ID",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Agent full name",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "description": "Agent email",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "description": "Specialty role",
          "maxLength": 120
        },
        "exp": {
          "type": "string",
          "description": "Experience summary",
          "maxLength": 64
        },
        "location": {
          "type": "string",
          "description": "Branch location",
          "maxLength": 120
        },
        "lang": {
          "type": "string",
          "description": "Languages spoken",
          "maxLength": 120
        },
        "img": {
          "type": "string",
          "description": "Portrait URL",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Pending", "Suspended"],
          "description": "Operational status"
        },
        "aum": {
          "type": "string",
          "description": "Managed AUM display string",
          "maxLength": 64
        },
        "clients": {
          "type": "number",
          "description": "Number of active clients"
        },
        "bio": {
          "type": "string",
          "description": "Advisor biography",
          "maxLength": 2000
        }
      },
      "required": ["id", "name", "role", "status"]
    },
    "systemConfig": {
      "title": "System & Admin Configuration",
      "description": "Global admin settings including configurable admin passcode",
      "type": "object",
      "properties": {
        "passcode": {
          "type": "string",
          "description": "Admin Center access passcode",
          "maxLength": 128
        },
        "adminEmail": {
          "type": "string",
          "description": "Primary admin email address",
          "maxLength": 256
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp",
          "maxLength": 64
        }
      },
      "required": ["passcode"]
    },
    "testConnection": {
      "title": "Connection Test",
      "description": "Heartbeat document to verify Firestore readiness",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Heartbeat status",
          "maxLength": 50
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Individual client account balances and profile data"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "User transaction history"
    },
    "/users/{userId}/policies/{policyId}": {
      "schema": "insurancePolicy",
      "description": "Active and past client insurance policies"
    },
    "/users/{userId}/cards/{cardId}": {
      "schema": "paymentCard",
      "description": "Linked client withdrawal methods (cards, banks, crypto, PayPal, etc.)"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "userNotification",
      "description": "Real-time notifications for the user"
    },
    "/chats/{chatId}": {
      "schema": "chatSession",
      "description": "Client chat threads funneled to admin"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "chatMessage",
      "description": "Messages, funding requests, invoices, and alerts within a client chat thread"
    },
    "/letterTemplates/{templateId}": {
      "schema": "letterTemplate",
      "description": "Saved admin templates for invoices, account alerts, and official letters"
    },
    "/agents/{agentId}": {
      "schema": "agentRecord",
      "description": "Accredited agents directory"
    },
    "/system/{docId}": {
      "schema": "systemConfig",
      "description": "System and admin passcode configuration"
    },
    "/admins/{adminId}": {
      "schema": "userProfile",
      "description": "Trusted admin users registry"
    },
    "/test/{docId}": {
      "schema": "testConnection",
      "description": "Connection test collection"
    }
  }
}
